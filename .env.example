# Supabase Authentication (required for sign-up, sign-in, and gated API access)
# Obtain these from your Supabase Project Settings -> API:
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-supabase-anon-public-key>

# NVIDIA API key (required). Used server-side only, for both text and images.
NVIDIA_API_KEY=        # nvapi-...

# Optional: step count for the flux.1-dev image model (default 28).
NVIDIA_IMAGE_STEPS=
