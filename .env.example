# Copy to .env.local for local development. On Netlify, set these in
# Site settings → Environment variables (do NOT commit real keys).

# At least one provider key is required. The app auto-selects available providers.
NVIDIA_API_KEY=        # nvapi-...  (image gen uses Black Forest Labs FLUX)
OPENAI_API_KEY=        # sk-...     (optional: GPT-4o-mini text + DALL-E 3 images)
GEMINI_API_KEY=        # AIzaSy...  (optional: Gemini text + image)

# Optional NVIDIA image tuning:
#   NVIDIA_IMAGE_MODEL  -> flux.1-schnell (default, fast ~2-4s) or flux.1-dev (higher quality, slower)
#   NVIDIA_IMAGE_STEPS  -> step count for flux.1-dev (default 30; ignored by schnell)
# Keep the default flux.1-schnell on Netlify's free tier (10s function timeout).
NVIDIA_IMAGE_MODEL=
NVIDIA_IMAGE_STEPS=
